Screen {
    background: #020307;
    color: #d8f7ff;
}

#banner {
    dock: top;
    height: 1;
    padding: 0 1;
    color: #8ccfe0;
    background: #07101b;
    border-bottom: solid #16324a;
}

#main-layout {
    height: 1fr;
    min-height: 12;
}

#world-view {
    width: 1fr;
    height: 1fr;
    padding: 1 1;
    overflow: hidden;
    background: #04070f;
    border: solid #17445f;
    color: #94dff0;
}

#right-panel {
    width: 42;
    height: 1fr;
    padding: 0 0 0 1;
}

#inspector {
    height: 1fr;
    border-left: solid #5d2d60;
    padding: 1 1;
    overflow-y: auto;
    background: #0a0710;
    color: #e9d5e8;
}

#minimap {
    height: 12;
    border-left: solid #5d2d60;
    border-top: solid #402341;
    padding: 1 1;
    background: #0a0d1a;
    color: #99dce9;
}

#hud {
    dock: bottom;
    height: 1;
    padding: 0 1;
    border-top: solid #183147;
    background: #06101b;
    color: #8ac7d7;
}
